{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@ui/*": ["./src/*"],
      "@stories/*": ["./stories/*"],
      "@web/*": ["../../apps/web/src/*"]
    }
  },
  "include": ["src/**/*", "stories/**/*", ".storybook/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "storybook-static",
    "coverage",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
