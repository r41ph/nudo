{
  "name": "writing-app",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:web": "pnpm --filter @writing-app/web dev",
    "dev:api": "pnpm --filter @writing-app/api dev",
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "storybook": "pnpm --filter @writing-app/ui storybook",
    "lint": "eslint .",
    "lint:workspaces": "pnpm --filter './apps/*' lint && pnpm --filter './packages/*' lint",
    "db:migrate": "pnpm --filter @writing-app/api migrate",
    "db:migrate:down": "pnpm --filter @writing-app/api migrate:down",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "test": "pnpm --filter './apps/*' test && pnpm --filter './packages/*' test",
    "test:web": "pnpm --filter @writing-app/web test",
    "test:api": "pnpm --filter @writing-app/api test",
    "test:api:int": "pnpm --filter @writing-app/api test:integration",
    "test:coverage": "pnpm --filter @writing-app/web test:coverage && pnpm --filter @writing-app/api test:coverage",
    "test:e2e": "pnpm --filter @writing-app/e2e test:e2e",
    "test:db:setup": "pnpm --filter @writing-app/api test:db:setup",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint:precommit": "eslint --config eslint.config.precommit.mts",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.3.0",
  "lint-staged": {
    "*.{ts,tsx,mts,mjs,js}": [
      "prettier --write",
      "pnpm lint:precommit --fix --max-warnings=0",
      "pnpm exec secretlint"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write",
      "pnpm exec secretlint"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^0.14.0",
    "@eslint/markdown": "^7.5.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "husky": "9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "17.0.4",
    "prettier": "^3.7.4",
    "secretlint": "13.0.0",
    "typescript-eslint": "^8.50.1"
  }
}
